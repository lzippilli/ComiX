<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RootNamespace>ComiX</RootNamespace>
  </PropertyGroup>

  <PropertyGroup Label="Package">
    <PackageId>ComiX</PackageId>
    <Version>1.0.0-preview.2</Version>
    <Authors>Lorenzo Zippilli</Authors>
    <Copyright>Copyright (c) 2026 Lorenzo Zippilli</Copyright>
    <Description>A .NET library for reading, extracting and converting comic book archives (CBZ, CBR, CB7, CBT) through a container-agnostic object model.</Description>
    <PackageTags>comic;cbz;cbr;cb7;cbt;comicinfo;metroninfo;comet;archive</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageProjectUrl>https://github.com/lzippilli/ComiX</PackageProjectUrl>
    <RepositoryUrl>https://github.com/lzippilli/ComiX</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <!--
      The publish workflow extracts the CHANGELOG section for the version into release-notes.md at
      the repository root. When present it becomes the package's release notes on nuget.org.
    -->
    <ReleaseNotesFile>$(MSBuildThisFileDirectory)../../release-notes.md</ReleaseNotesFile>
    <PackageReleaseNotes Condition="Exists('$(ReleaseNotesFile)')">$([System.IO.File]::ReadAllText('$(ReleaseNotesFile)'))</PackageReleaseNotes>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="SharpCompress" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" Visible="false" />
    <InternalsVisibleTo Include="ComiX.Tests" />
  </ItemGroup>

</Project>
